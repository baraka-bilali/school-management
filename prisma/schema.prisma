generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  role              User_role @default(ELEVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  nom               String?
  prenom            String?
  telephone         String?
  fonction          String?
  schoolId          Int?
  dateCreation      DateTime? @default(now())
  temporaryPassword Boolean   @default(false)
  isActive          Boolean   @default(true)
  canEnrollStudents Boolean   @default(false)
  createdSchools    School[]  @relation("SchoolsCreated")
  student           Student?
  teacher           Teacher?
  parent            Parent?
  school            School?   @relation("SchoolAdmins", fields: [schoolId], references: [id])
  subscriptionPayments SubscriptionPayment[] @relation("SubscriptionPayments")
  communiques          Communique[]           @relation("CommuniquesCreated")
  communiqueUserReads  CommuniqueUserRead[]
  staffPayments        StaffPayment[]
  enrollmentDecisionChanges EnrollmentDecisionHistory[]

  @@index([schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId, role, isActive])
}

model AcademicYear {
  id              Int                @id @default(autoincrement())
  name            String             @unique
  current         Boolean            @default(false)
  startDate       DateTime?
  endDate         DateTime?
  enrollments     Enrollment[]
  tarifications   Tarification[]
  receiptCounters ReceiptCounter[]
  assignments     CourseAssignment[]
  slots           ScheduleSlot[]
  communiques     Communique[]
}

model Class {
  id            Int                @id @default(autoincrement())
  name          String
  level         String
  createdAt     DateTime           @default(now())
  letter        String
  section       String
  stream        String?
  schoolId      Int
  /// Classe supérieure recommandée pour le passage (optionnel)
  nextClassId   Int?
  /// Enseignant titulaire (primaire) — note toutes les branches de la classe
  titulaireTeacherId Int?
  school        School             @relation(fields: [schoolId], references: [id])
  nextClass     Class?             @relation("ClassPromotion", fields: [nextClassId], references: [id])
  previousClasses Class[]          @relation("ClassPromotion")
  titulaireTeacher Teacher?        @relation("ClassTitulaire", fields: [titulaireTeacherId], references: [id])
  enrollments   Enrollment[]
  tarifications Tarification[]
  assignments    CourseAssignment[]
  slots         ScheduleSlot[]
  tasks         StudentTask[]
  gradeLocks    GradeEntryLock[]

  @@unique([name, schoolId])
  @@index([section])
  @@index([level])
  @@index([schoolId])
  @@index([section, level, letter])
  @@index([nextClassId])
  @@index([titulaireTeacherId])
}

model Student {
  id          Int          @id @default(autoincrement())
  userId      Int          @unique
  /// Matricule permanent, généré une fois à la création, jamais recalculé
  permanentCode String
  lastName    String
  middleName  String
  firstName   String
  gender      String
  birthDate   DateTime
  // Informations complémentaires
  birthPlace  String?
  nationality String?
  address     String?      @db.Text
  photoUrl    String?      @db.Text
  // Parent / Tuteur 1 (legacy / complément fiche — préférer Parent/ParentStudent)
  parentName1  String?
  parentPhone1 String?
  parentJob1   String?
  parentEmail1 String?
  // Parent / Tuteur 2
  parentName2  String?
  parentPhone2 String?
  parentJob2   String?
  parentEmail2 String?
  // Informations médicales
  bloodGroup         String?
  allergies          String?   @db.Text
  medicalNotes       String?   @db.Text
  emergencyContact   String?
  emergencyPhone     String?
  profileCompleted   Boolean   @default(false)

  enrollments    Enrollment[]
  paiements      Paiement[]
  communiqueReads CommuniqueRead[]
  parentLinks    ParentStudent[]
  user           User         @relation(fields: [userId], references: [id])

  @@unique([permanentCode])
  @@index([lastName])
  @@index([lastName, firstName])
}

model Teacher {
  id          Int                @id @default(autoincrement())
  userId      Int                @unique
  lastName    String
  middleName  String
  firstName   String
  gender      String
  birthDate   DateTime
  specialty   String?
  phone       String?
  hiredAt     DateTime?          @default(now())
  user        User               @relation(fields: [userId], references: [id])
  payments    TeacherPayment[]
  assignments CourseAssignment[]
  tasks         StudentTask[]
  titulaireClasses Class[] @relation("ClassTitulaire")

  @@index([lastName])
  @@index([specialty])
  @@index([lastName, firstName])
}

model Parent {
  id         Int             @id @default(autoincrement())
  userId     Int             @unique
  lastName   String
  firstName  String
  middleName String?
  phone      String?
  user       User            @relation(fields: [userId], references: [id])
  students   ParentStudent[]

  @@index([lastName])
  @@index([lastName, firstName])
}

model ParentStudent {
  id               Int     @id @default(autoincrement())
  parentId         Int
  studentId        Int
  relationship     String?
  isPrimaryContact Boolean @default(false)
  parent           Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Enrollment {
  id                  Int                @id @default(autoincrement())
  studentId           Int
  classId             Int
  yearId              Int
  /// Numéro affiché dans la classe pour cette année (ex: "1", "12")
  code                String?
  status              EnrollmentStatus   @default(ACTIVE)
  origine             EnrollmentOrigine  @default(NOUVEL_ENTRANT)
  decisionPassage     DecisionPassage?
  dateDecision        DateTime?
  commentaireConseil  String?            @db.Text
  exitReason          String?
  createdAt           DateTime           @default(now())
  class               Class              @relation(fields: [classId], references: [id])
  student             Student            @relation(fields: [studentId], references: [id])
  year                AcademicYear       @relation(fields: [yearId], references: [id])
  paiements           Paiement[]
  decisionHistory     EnrollmentDecisionHistory[]
  grades              Grade[]
  examGrades          ExamGrade[]

  @@unique([studentId, yearId])
  @@index([classId])
  @@index([yearId])
  @@index([studentId, yearId, status])
  @@index([yearId, status])
  @@index([yearId, createdAt])
  @@index([classId, yearId, code])
}

/// Historique des changements de décision de passage (conseil de classe)
model EnrollmentDecisionHistory {
  id              Int               @id @default(autoincrement())
  enrollmentId    Int
  oldDecision     DecisionPassage?
  newDecision     DecisionPassage?
  oldComment      String?           @db.Text
  newComment      String?           @db.Text
  changedByUserId Int
  createdAt       DateTime          @default(now())
  enrollment      Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  changedBy       User              @relation(fields: [changedByUserId], references: [id])

  @@index([enrollmentId])
  @@index([changedByUserId])
  @@index([createdAt])
}

model School {
  id                          Int               @id @default(autoincrement())
  nomEtablissement            String
  typeEtablissement           TypeEtablissement @default(PRIVE)
  niveauEnseignement          String?           @db.Text
  codeEtablissement           String?           @unique
  anneeCreation               Int?
  slogan                      String?
  logoUrl                     String?           @db.Text
  sealUrl                     String?           @db.Text
  profilePhotoUrl             String?           @db.Text
  statutJuridique             String?
  rccm                        String?
  idNat                       String?
  nif                         String?
  agrementMinisteriel         String?
  dateAgrement                DateTime?
  ministereTutelle            String?
  statutsReglements           String?
  responsableLegal            String?
  pieceIdentiteResponsable    String?
  adresse                     String
  ville                       String
  province                    String
  pays                        String            @default("RDC")
  telephone                   String
  email                       String
  siteWeb                     String?
  directeurNom                String
  directeurTelephone          String
  directeurEmail              String?
  secretaireAcademique        String?
  comptable                   String?
  personnelAdministratifTotal Int?
  cycles                      String?
  nombreClasses               Int?
  nombreEleves                Int?
  nombreEnseignants           Int?
  langueEnseignement          String?
  programmes                  String?
  calendrierScolaire          String?           @db.Text
  joursOuverture              String?
  domaine                     String?
  identifiantInterne          String            @unique @default(uuid())
  etatCompte                  EtatCompte        @default(EN_ATTENTE)
  dateInscription             DateTime          @default(now())
  derniereMiseAJour           DateTime          @updatedAt
  creeParId                   Int?
  modifieParId                Int?
  dateCreation                DateTime          @default(now())
  dateModification            DateTime          @updatedAt
  dateDebutAbonnement         DateTime?
  dateFinAbonnement           DateTime?
  periodeAbonnement           String?
  planAbonnement              String?
  typePaiement                String?
  montantPaye                 Float?
  createdBy                   User?                  @relation("SchoolsCreated", fields: [creeParId], references: [id])
  admins                      User[]                 @relation("SchoolAdmins")
  classes                     Class[]
  subscriptionPayments        SubscriptionPayment[]
  communiques                 Communique[]
  evaluationCycles            EvaluationCycle[]
  primaryDegrees              PrimaryDegree[]
  gradeLocks                  GradeEntryLock[]

  @@index([codeEtablissement])
  @@index([email])
  @@index([creeParId])
}

model Notification {
  id         Int                @id @default(autoincrement())
  type       NotificationType
  message    String             @db.Text
  schoolId   Int?
  userId     Int?
  targetRole NotificationTarget @default(ALL)
  isRead     Boolean            @default(false)
  daysLeft   Int?
  createdAt  DateTime           @default(now())

  @@index([userId, isRead])
  @@index([schoolId, isRead])
  @@index([targetRole, isRead])
  @@index([createdAt])
}

// ============================================================
// MODULE FRAIS SCOLAIRES
// ============================================================

model TypeFrais {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  nom           String
  description   String?         @db.Text
  schoolId      Int
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tarifications Tarification[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Tarification {
  id           Int          @id @default(autoincrement())
  typeFraisId  Int
  yearId       Int
  classId      Int?
  montant      Float
  devise       Devise       @default(USD)
  description  String?      @db.Text
  schoolId     Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  typeFrais    TypeFrais    @relation(fields: [typeFraisId], references: [id])
  year         AcademicYear @relation(fields: [yearId], references: [id])
  class        Class?       @relation(fields: [classId], references: [id])
  echeances    Echeance[]
  paiements    Paiement[]

  @@unique([typeFraisId, yearId, classId, schoolId])
  @@index([schoolId])
  @@index([yearId])
  @@index([schoolId, yearId, isActive])
  @@index([yearId, isActive, classId])
  @@index([classId])
  @@index([typeFraisId])
}

model Echeance {
  id              Int          @id @default(autoincrement())
  tarificationId  Int
  nom             String
  montant         Float
  dateEcheance    DateTime
  ordre           Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tarification    Tarification @relation(fields: [tarificationId], references: [id], onDelete: Cascade)

  @@index([tarificationId])
  @@index([dateEcheance])
}

model Paiement {
  id               Int                    @id @default(autoincrement())
  numeroRecu       String                 @unique
  enrollmentId     Int
  studentId        Int
  tarificationId   Int
  montant          Float
  datePaiement     DateTime               @default(now())
  modePaiement     ModePaiement           @default(CASH)
  reference        String?
  notes            String?                @db.Text
  recuPdfPath      String?
  schoolId         Int
  createdBy        Int
  isAnnule         Boolean                @default(false)
  motifAnnulation  String?                @db.Text
  annulePar        Int?
  dateAnnulation   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  enrollment       Enrollment             @relation(fields: [enrollmentId], references: [id])
  student          Student                @relation(fields: [studentId], references: [id])
  tarification     Tarification           @relation(fields: [tarificationId], references: [id])
  modifications    PaiementModification[]

  @@index([schoolId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([schoolId, isAnnule])
  @@index([enrollmentId, isAnnule])
  @@index([tarificationId, isAnnule])
  @@index([studentId, isAnnule])
  @@index([tarificationId])
  @@index([numeroRecu])
  @@index([datePaiement])
  @@index([schoolId, datePaiement])
}

model PaiementModification {
  id              Int      @id @default(autoincrement())
  paiementId      Int
  champModifie    String
  ancienneValeur  String   @db.Text
  nouvelleValeur  String   @db.Text
  modifiePar      Int
  motif           String?  @db.Text
  createdAt       DateTime @default(now())
  paiement        Paiement @relation(fields: [paiementId], references: [id])

  @@index([paiementId])
  @@index([createdAt])
}

model ReceiptCounter {
  id        Int          @id @default(autoincrement())
  schoolId  Int
  yearId    Int
  counter   Int          @default(0)
  year      AcademicYear @relation(fields: [yearId], references: [id])

  @@unique([schoolId, yearId])
}

// ============================================================
// MODULE TRÉSORERIE — SALAIRES & DÉPENSES
// ============================================================

model TeacherPayment {
  id            Int          @id @default(autoincrement())
  teacherId     Int
  schoolId      Int
  montant       Float
  type          PaymentType  @default(SALAIRE)
  mois          String       // ex: "2026-04"
  description   String?      @db.Text
  modePaiement  ModePaiement @default(CASH)
  reference     String?
  datePaiement  DateTime     @default(now())
  createdBy     Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teacher       Teacher      @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([teacherId])
  @@index([datePaiement])
  @@index([schoolId, mois])
}

model StaffPayment {
  id            Int          @id @default(autoincrement())
  userId        Int
  schoolId      Int
  montant       Float
  type          PaymentType  @default(SALAIRE)
  mois          String
  description   String?      @db.Text
  modePaiement  ModePaiement @default(CASH)
  reference     String?
  datePaiement  DateTime     @default(now())
  createdBy     Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([datePaiement])
  @@index([schoolId, mois])
}

model SchoolExpense {
  id            Int             @id @default(autoincrement())
  schoolId      Int
  categorie     ExpenseCategory @default(AUTRE)
  motif         String          @db.Text
  montant       Float
  devise        Devise          @default(USD)
  beneficiaire  String?
  modePaiement  ModePaiement    @default(CASH)
  reference     String?
  dateDepense   DateTime        @default(now())
  createdBy     Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([schoolId])
  @@index([dateDepense])
  @@index([schoolId, categorie])
  @@index([schoolId, devise])
}

enum PaymentType {
  SALAIRE
  PRIME
  BONUS
  AVANCE
  AUTRE
}

enum ExpenseCategory {
  FOURNITURES
  EQUIPEMENT
  MAINTENANCE
  TRANSPORT
  COMMUNICATION
  EVENEMENT
  AUTRE
}

enum User_role {
  ADMIN
  ELEVE
  COMPTABLE
  CAISSIER
  PROFESSEUR
  PARENT
  DIRECTEUR_DISCIPLINE
  DIRECTEUR_ETUDES
  DIRECTEUR_ADJOINT
  SECRETAIRE
  INTENDANT
  SURVEILLANT_GENERAL
  BIBLIOTHECAIRE
  INFIRMIER
  CONSEILLER_PEDAGOGIQUE
  SUPER_ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  DROPPED_OUT
  EXPELLED
  PROPOSEE
  CONFIRMEE
}

enum EnrollmentOrigine {
  NOUVEL_ENTRANT
  PASSAGE
  REDOUBLEMENT
  TRANSFERT
}

enum DecisionPassage {
  PASSAGE
  REDOUBLEMENT
  ORIENTATION
  RENVOI
}

enum TypeEtablissement {
  PUBLIC
  PRIVE
  SEMI_PRIVE
}

enum EtatCompte {
  ACTIF
  EN_ATTENTE
  SUSPENDU
}

enum NotificationType {
  SUBSCRIPTION_EXPIRING_15_DAYS
  SUBSCRIPTION_EXPIRING_10_DAYS
  SUBSCRIPTION_EXPIRING_5_DAYS
  SUBSCRIPTION_EXPIRING_2_DAYS
  SUBSCRIPTION_EXPIRING_1_DAY
  SUBSCRIPTION_EXPIRED
  SYSTEM_MESSAGE
  SUBSCRIPTION_PAYMENT_RECEIVED
  SUBSCRIPTION_CANCELLED
}

enum NotificationTarget {
  SUPER_ADMIN_ONLY
  SCHOOL_USER_ONLY
  ALL
}

enum ModePaiement {
  CASH
  VIREMENT
  MOBILE_MONEY
  CHEQUE
  AUTRE
}

enum Devise {
  USD
  CDF
}

// ============================================================
// MODULE ABONNEMENTS — PAIEMENTS & FACTURES
// ============================================================

model SubscriptionPayment {
  id            Int      @id @default(autoincrement())
  schoolId      Int
  montant       Float
  devise        String   @default("USD")
  typePaiement  String
  reference     String?
  dateDebut     DateTime
  dateFin       DateTime
  periode       String
  plan          String
  numeroFacture String   @unique
  notes         String?  @db.Text
  statut        String   @default("ACTIF")
  createdAt     DateTime @default(now())
  createdById   Int?
  school        School   @relation(fields: [schoolId], references: [id])
  createdBy     User?    @relation("SubscriptionPayments", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([createdAt])
  @@index([numeroFacture])
}

model SubscriptionInvoiceCounter {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================================
// MODULE GESTION D'HORAIRES
// ============================================================

model Subject {
  id              Int                @id @default(autoincrement())
  name            String             // ex: Mathématiques
  code            String             // ex: MATH
  description     String?            @db.Text
  color           String?            // ex: #4f46e5
  coefficient     Float              @default(1)
  maxWeeklyHours  Int                @default(5)
  /// Libellé de regroupement visuel pour le bulletin (ex: "Mathématiques")
  groupLabel      String?
  /// Parent optionnel pour sous-totaux futurs ; chaque matière reste notée indépendamment en V1
  parentSubjectId Int?
  schoolId        Int
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  parent          Subject?           @relation("SubjectHierarchy", fields: [parentSubjectId], references: [id])
  children        Subject[]          @relation("SubjectHierarchy")
  assignments     CourseAssignment[]
  tasks           StudentTask[]
  periodMaxima    SubjectPeriodMax[]
  examMaxima      SubjectExamMax[]
  examGrades      ExamGrade[]
  primaryBranch   PrimaryBranch?
  gradeLocks      GradeEntryLock[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([parentSubjectId])
  @@index([groupLabel])
}

model StudentTask {
  id          Int      @id @default(autoincrement())
  title       String
  question    String?  @db.Text
  description String?  @db.Text
  dueAt       DateTime
  classId     Int
  subjectId   Int?
  teacherId   Int
  schoolId    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class   Class    @relation(fields: [classId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])
  teacher Teacher  @relation(fields: [teacherId], references: [id])

  @@index([classId, dueAt])
  @@index([schoolId, isActive])
}

model CourseAssignment {
  id                 Int                 @id @default(autoincrement())
  subjectId          Int
  teacherId          Int
  classId            Int
  yearId             Int
  weeklyHours        Float               // heures allouées par semaine
  maxDailyHours      Float?              // plafond horaire par jour
  schoolId           Int
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subject            Subject             @relation(fields: [subjectId], references: [id])
  teacher            Teacher             @relation(fields: [teacherId], references: [id])
  class              Class               @relation(fields: [classId], references: [id])
  year               AcademicYear        @relation(fields: [yearId], references: [id])
  slots              ScheduleSlot[]
  evaluationColumns  EvaluationColumn[]
  examGrades         ExamGrade[]

  @@unique([subjectId, classId, yearId, schoolId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([yearId])
}

model ScheduleSlot {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  classId      Int
  dayOfWeek    Int              // 1=Lundi … 6=Samedi
  startTime    String           // "08:00"
  endTime      String           // "09:00"
  room         String?
  schoolId     Int
  yearId       Int
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   CourseAssignment @relation(fields: [assignmentId], references: [id])
  class        Class            @relation(fields: [classId], references: [id])
  year         AcademicYear     @relation(fields: [yearId], references: [id])

  @@index([schoolId])
  @@index([classId])
  @@index([assignmentId])
  @@index([dayOfWeek])
  @@index([yearId])
}

model ScheduleBreak {
  id        Int       @id @default(autoincrement())
  name      String    // "Récréation du matin"
  type      BreakType @default(RECREATION)
  startTime String    // "10:00"
  endTime   String    // "10:20"
  duration  Int       // durée en minutes
  section   String?   // "Primaire", "Secondaire" ou null = tous
  schoolId  Int
  dayOfWeek Int?      // null = tous les jours scolaires
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
}

enum BreakType {
  RECREATION
  PAUSE_DEJEUNER
  INTER_COURS
  DEBUT_VACATION
  FIN_VACATION
}

// ============================================================
// MODULE COMMUNIQUÉS
// ============================================================

model Communique {
  id              Int           @id @default(autoincrement())
  title           String
  content         String        @db.Text
  schoolId        Int
  yearId          Int?
  createdById     Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  targetStudents  Boolean       @default(true)
  targetParents   Boolean       @default(false)
  targetTeachers  Boolean       @default(false)
  targetStaff     Boolean       @default(false)
  attachmentUrl   String?       @db.Text
  attachmentName  String?
  attachmentMime  String?
  school          School        @relation(fields: [schoolId], references: [id])
  year            AcademicYear? @relation(fields: [yearId], references: [id])
  createdBy       User          @relation("CommuniquesCreated", fields: [createdById], references: [id])
  reads           CommuniqueRead[]
  userReads       CommuniqueUserRead[]

  @@index([schoolId])
  @@index([yearId])
  @@index([createdAt])
  @@index([schoolId, createdAt])
  @@index([schoolId, yearId])
}

model CommuniqueUserRead {
  id           Int        @id @default(autoincrement())
  communiqueId Int
  userId       Int
  readAt       DateTime   @default(now())
  communique   Communique @relation(fields: [communiqueId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([communiqueId, userId])
  @@index([userId])
  @@index([communiqueId])
}

model CommuniqueRead {
  id           Int        @id @default(autoincrement())
  communiqueId Int
  studentId    Int
  readAt       DateTime   @default(now())
  communique   Communique @relation(fields: [communiqueId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([communiqueId, studentId])
  @@index([studentId])
  @@index([communiqueId])
}

// ---------------------------------------------------------------------------
// Notation / cotations (périodes configurables, colonnes enseignant, notes)
// ---------------------------------------------------------------------------

/// Primaire (3 trimestres) vs Secondaire/CTEB/Humanités (2 semestres)
enum EvaluationCycleKind {
  PRIMARY
  SECONDARY
}

/// Configuration d'évaluation d'une école (réutilisable d'une année à l'autre)
model EvaluationCycle {
  id           Int                       @id @default(autoincrement())
  schoolId     Int
  name         String
  kind         EvaluationCycleKind
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  school       School                    @relation(fields: [schoolId], references: [id])
  sections     EvaluationCycleSection[]
  periodGroups PeriodGroup[]

  @@unique([schoolId, kind])
  @@index([schoolId])
}

/// Associe un cycle aux valeurs de Class.section (ex: "Primaire", "Humanités")
model EvaluationCycleSection {
  id      Int             @id @default(autoincrement())
  cycleId Int
  section String
  cycle   EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, section])
  @@index([section])
}

/// Trimestre ou semestre au sein d'un cycle
model PeriodGroup {
  id         Int                @id @default(autoincrement())
  cycleId    Int
  name       String
  sortOrder  Int
  hasExam    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  cycle      EvaluationCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  periods    Period[]
  examMaxima SubjectExamMax[]
  examGrades ExamGrade[]
  gradeLocks GradeEntryLock[]

  @@unique([cycleId, sortOrder])
  @@index([cycleId])
}

/// Période de travaux journaliers (ex: 1ère PER, 2ème PER)
model Period {
  id               Int                 @id @default(autoincrement())
  periodGroupId    Int
  name             String
  sortOrder        Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  periodGroup      PeriodGroup         @relation(fields: [periodGroupId], references: [id], onDelete: Cascade)
  periodMaxima     SubjectPeriodMax[]
  evaluationColumns EvaluationColumn[]
  gradeLocks       GradeEntryLock[]

  @@unique([periodGroupId, sortOrder])
  @@index([periodGroupId])
}

/// Maximum officiel matière × degré (section+level[+filière]) × période
/// Primaire/EB : stream vide. Humanités : stream = filière (ex. Scientifique).
/// Classes parallèles du même degré+filière partagent le même max.
model SubjectPeriodMax {
  id        Int      @id @default(autoincrement())
  subjectId Int
  /// Correspond à Class.section (ex: "Primaire", "Education de Base", "Humanités")
  section   String
  /// Correspond à Class.level (ex: "7ème", "1ère")
  level     String
  /// Correspond à Class.stream ; "" si pas de filière (primaire, EB, etc.)
  stream    String   @default("")
  periodId  Int
  schoolId  Int
  maxPoints Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([subjectId, section, level, stream, periodId])
  @@index([schoolId])
  @@index([section, level, stream])
  @@index([periodId])
}

/// Maximum officiel matière × degré[+filière] × examen de trimestre/semestre
model SubjectExamMax {
  id            Int         @id @default(autoincrement())
  subjectId     Int
  section       String
  level         String
  stream        String      @default("")
  periodGroupId Int
  schoolId      Int
  maxPoints     Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  periodGroup   PeriodGroup @relation(fields: [periodGroupId], references: [id], onDelete: Cascade)

  @@unique([subjectId, section, level, stream, periodGroupId])
  @@index([schoolId])
  @@index([section, level, stream])
  @@index([periodGroupId])
}

/// Colonne d'évaluation créée par l'enseignant (devoir, interrogation, etc.)
model EvaluationColumn {
  id                 Int              @id @default(autoincrement())
  courseAssignmentId Int
  periodId           Int
  label              String
  date               DateTime         @db.Date
  maxPoints          Float
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  assignment         CourseAssignment @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  period             Period           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  grades             Grade[]

  @@index([courseAssignmentId, periodId])
  @@index([periodId])
}

/// Note d'un élève sur une colonne d'évaluation (liée à l'inscription de l'année)
model Grade {
  id                 Int              @id @default(autoincrement())
  evaluationColumnId Int
  enrollmentId       Int
  pointsObtained     Float
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  column             EvaluationColumn @relation(fields: [evaluationColumnId], references: [id], onDelete: Cascade)
  enrollment         Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([evaluationColumnId, enrollmentId])
  @@index([enrollmentId])
}

/// Note d'examen unique (saisie directe sur le maximum officiel, pas de colonnes)
model ExamGrade {
  id                 Int              @id @default(autoincrement())
  enrollmentId       Int
  subjectId          Int
  periodGroupId      Int
  courseAssignmentId Int
  pointsObtained     Float
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  enrollment         Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject            Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  periodGroup        PeriodGroup      @relation(fields: [periodGroupId], references: [id], onDelete: Cascade)
  assignment         CourseAssignment @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, subjectId, periodGroupId])
  @@index([periodGroupId])
  @@index([subjectId])
  @@index([courseAssignmentId])
}

// ============================================================
// CURRICULUM PRIMAIRE OFFICIEL (Domaines / Groupes / Branches)
// Source de vérité : maxPeriode uniquement
// maxExamen = 2×, maxTrimestre = 4×, maxAnnuel = 12×
// ============================================================

enum PrimaryDegreeCode {
  ELEMENTAIRE // 1ère, 2ème
  MOYEN       // 3ème, 4ème — needsReview
  TERMINAL_5  // 5ème — needsReview
  TERMINAL_6  // 6ème
}

enum GradeLockKind {
  PERIOD
  EXAM
}

/// Structure officielle d'un degré primaire pour une école
model PrimaryDegree {
  id          Int               @id @default(autoincrement())
  schoolId    Int
  code        PrimaryDegreeCode
  name        String
  /// Niveaux Class.level couverts (ex: ["1ère","2ème"])
  levelsJson  String            @db.Text
  /// true = données provisoires à faire confirmer par un enseignant
  needsReview Boolean           @default(false)
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  domains     PrimaryDomain[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model PrimaryDomain {
  id        Int              @id @default(autoincrement())
  degreeId  Int
  name      String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  degree    PrimaryDegree    @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  groups    PrimaryGroup[]
  branches  PrimaryBranch[]

  @@index([degreeId, sortOrder])
}

/// Regroupement intermédiaire optionnel (ex: Français, Mathématiques)
model PrimaryGroup {
  id        Int             @id @default(autoincrement())
  domainId  Int
  name      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  domain    PrimaryDomain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  branches  PrimaryBranch[]

  @@index([domainId, sortOrder])
}

/// Branche notée — seul maxPeriode est stocké (source de vérité)
model PrimaryBranch {
  id                  Int            @id @default(autoincrement())
  domainId            Int
  /// null = branche directement sous le domaine
  groupId             Int?
  name                String
  maxPeriode          Float
  /// Overrides optionnels si un cas hors formule 2×/4×/12× apparaît
  maxExamenOverride   Float?
  maxTrimestreOverride Float?
  maxAnnuelOverride   Float?
  sortOrder           Int            @default(0)
  /// Matière liée pour la notation / affectations
  subjectId           Int?           @unique
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  domain              PrimaryDomain  @relation(fields: [domainId], references: [id], onDelete: Cascade)
  group               PrimaryGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  subject             Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([domainId, sortOrder])
  @@index([groupId])
}

/// Verrouillage après validation d'une période ou d'un examen
model GradeEntryLock {
  id                 Int           @id @default(autoincrement())
  schoolId           Int
  classId            Int
  subjectId          Int
  kind               GradeLockKind
  periodId           Int?
  periodGroupId      Int?
  courseAssignmentId Int?
  lockedAt           DateTime      @default(now())
  lockedByUserId     Int
  unlockedAt         DateTime?
  unlockedByUserId   Int?
  unlockReason       String?       @db.Text
  school             School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period             Period?       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodGroup        PeriodGroup?  @relation(fields: [periodGroupId], references: [id], onDelete: Cascade)

  @@index([schoolId, classId, subjectId])
  @@index([periodId])
  @@index([periodGroupId])
  @@index([lockedByUserId])
}
